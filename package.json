{
  "name": "supportos",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/widget",
    "apps/widget-warm",
    "apps/admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:widget": "npm run dev --workspace=apps/widget",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspace=apps/widget && npm run build --workspace=apps/widget-warm && npm run build --workspace=apps/backend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:widget": "npm run build --workspace=apps/widget",
    "build:admin": "npm run build --workspace=apps/admin",
    "db:warm-support:migrate": "npx supabase db query --linked --file docs/migrations/009-warm-support-data.sql",
    "seed:warm-support": "node scripts/seed-warm-support-data.mjs",
    "seed:warm-support:dry-run": "node scripts/seed-warm-support-data.mjs --dry-run",
    "health:inflow": "node scripts/diagnostics/check-ticket-inflow.mjs",
    "start": "npm run start --workspace=apps/backend"
  },
  "dependencies": {
    "express-rate-limit": "^8.3.1"
  },
  "devDependencies": {
    "postgres": "^3.4.9"
  }
}
