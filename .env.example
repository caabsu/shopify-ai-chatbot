# DeepSeek V4 only for support writing, planning and independent verification
AUTOPILOT_AI_PROVIDER=vercel-ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AUTOPILOT_FLASH_MODEL=deepseek/deepseek-v4.1-flash
AUTOPILOT_PRO_MODEL=deepseek/deepseek-v4-pro
AUTOPILOT_GATEWAY_DISALLOW_TRAINING=true
AUTOPILOT_GATEWAY_ZDR=false
DEEPSEEK_API_KEY=
AUTOPILOT_BRANDS=warm-by-design

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
SUPPORT_AUTOMATION_ADMIN_URL=
